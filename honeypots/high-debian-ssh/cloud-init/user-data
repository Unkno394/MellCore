#cloud-config
users:
  - name: analyst
    groups: [adm, systemd-journal]
    shell: /bin/bash
    lock_passwd: false
    passwd: '@@ANALYST_PASSWORD_HASH@@'
ssh_pwauth: true
disable_root: false
write_files:
  - path: /usr/local/lib/honeyforge/high-telemetry-sensor
    owner: root:root
    permissions: '0755'
    encoding: b64
    content: '@@SENSOR_B64@@'
  - path: /etc/systemd/system/honeyforge-high-telemetry.service
    owner: root:root
    permissions: '0644'
    encoding: b64
    content: '@@SENSOR_SERVICE_B64@@'
  - path: /usr/local/lib/honeyforge/high_telemetry_audit.py
    owner: root:root
    permissions: '0644'
    encoding: b64
    content: '@@AUDIT_SENSOR_B64@@'
  - path: /etc/audit/rules.d/90-honeyforge.rules
    owner: root:root
    permissions: '0600'
    encoding: b64
    content: '@@AUDIT_RULES_B64@@'
  - path: /etc/ssh/sshd_config.d/90-honeyforge.conf
    owner: root:root
    permissions: '0644'
    content: |
      PasswordAuthentication yes
      PermitRootLogin prohibit-password
      X11Forwarding no
  - path: /etc/systemd/system/qemu-guest-agent.service.d/10-honeyforge.conf
    owner: root:root
    permissions: '0644'
    content: |
      [Service]
      Restart=always
      RestartSec=2
runcmd:
  - test -x /usr/bin/python3
  - test -x /usr/sbin/sshd
  - sh -c 'test -x /usr/sbin/qemu-ga || test -x /usr/bin/qemu-ga'
  - test -x /usr/sbin/auditd
  - systemctl daemon-reload
  - augenrules --load
  - systemctl enable --now auditd
  - sh -c 'systemctl enable qemu-guest-agent.service >/dev/null 2>&1 || true'
  - systemctl restart qemu-guest-agent.service
  - systemctl is-active --quiet qemu-guest-agent.service
  - systemctl enable --now ssh
  - systemctl enable --now honeyforge-high-telemetry.service
  - systemctl is-active --quiet honeyforge-high-telemetry.service
