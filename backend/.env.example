# These are development defaults, not credentials. The binary reads process
# environment variables; it does not automatically load .env files.
API_BIND=127.0.0.1:8080
DOCS_ENABLED=false
RUST_LOG=honeyforge_backend=info
HTTP_MAX_BODY_BYTES=1048576
TELEMETRY_MAX_BATCH_EVENTS=100
TELEMETRY_MAX_PAYLOAD_BYTES=65536
TELEMETRY_MAX_METADATA_BYTES=8192
TELEMETRY_MAX_EVENT_AGE_SECONDS=604800
TELEMETRY_MAX_FUTURE_SKEW_SECONDS=300
RETENTION_DAYS=30
# Internal honeypot ingestion bearer; generate >=32 random bytes, keep secret.
# TELEMETRY_INGEST_TOKEN=
# Public URL embedded into Pritvoryashka runtime config; HTTPS except loopback.
# TELEMETRY_PUBLIC_ENDPOINT=http://127.0.0.1:8080/internal/v1/telemetry/batches
INTEGRATION_MODE=mock

# Legacy fallback for FRONTEND_URL.
APP_ORIGIN=https://localhost
# Public frontend origin for CORS and both email links. HTTPS in production.
# FRONTEND_URL=http://localhost:5173
FRONTEND_RESET_PATH=/reset-password
FRONTEND_VERIFY_PATH=/verify-email
# Compatibility default. Enable after SMTP + frontend confirmation pages are ready.
REQUIRE_EMAIL_VERIFICATION=false
# Required for API with PostgreSQL; generate >=32 random bytes, keep secret.
# JWT_SECRET=
JWT_TTL_SECONDS=900
AUTH_MAX_CONCURRENCY=2
LOGIN_PER_MINUTE=30

# PostgreSQL is optional for health/schema-only startup; required for management.
# DATABASE_URL=postgres://honeyforge:CHANGE_ME@127.0.0.1:54329/honeyforge
DATABASE_MAX_CONNECTIONS=5
# Explicit exception for disposable/local loopback PostgreSQL without TLS.
# Remote connections always use certificate + hostname verification.
DATABASE_ALLOW_INSECURE_LOCAL=false

# Used only by Docker Compose. Supply a local password before starting it.
# POSTGRES_PASSWORD=
POSTGRES_PORT=54329
# Bootstrap command only: supply these temporarily; never commit real values.
# BOOTSTRAP_USERNAME=admin
# BOOTSTRAP_EMAIL=admin@example.com
# BOOTSTRAP_PASSWORD=

# Existing email-less accounts only: attach-email command.
# LEGACY_USERNAME=admin
# LEGACY_EMAIL=admin@example.com

# Configure host, username, password and from to enable reset + verification mail.
# Without SMTP, forgot-password and resend-verification return 503.
# SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_TLS_MODE=implicit
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# Use SMTP_TLS_MODE=starttls and SMTP_PORT=587 if required by the mail provider.
# Certificate verification is always enabled; plaintext SMTP is not supported.
# No domain or credentials belonging to Lera are embedded in code.
# Links: FRONTEND_URL + FRONTEND_RESET_PATH or FRONTEND_VERIFY_PATH + #token=...
