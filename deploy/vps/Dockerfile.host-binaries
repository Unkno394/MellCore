FROM rust:1.95-bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev libssh2-1-dev && rm -rf /var/lib/apt/lists/*
ENV CARGO_BUILD_JOBS=1 CARGO_PROFILE_RELEASE_LTO=false CARGO_PROFILE_RELEASE_CODEGEN_UNITS=8
WORKDIR /src
COPY . .
RUN cargo build --release --locked -p hf-center -p hf-agent

FROM scratch
COPY --from=build /src/target/release/hf-center /artifacts/hf-center
COPY --from=build /src/target/release/hf-agent /artifacts/hf-agent
